{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:5173"
        ],
        "methods": [
          "GET",
          "HEAD",
          "PUT"
        ],
        "headers": [
          "*"
        ]
      },
      "expose_headers": [
        "ETag"
      ],
      "max_age_seconds": 3600
    }
  ]
}
