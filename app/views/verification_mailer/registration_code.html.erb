<!doctype html>
<html lang="en">
  <body style="margin:0;background:#071b12;font-family:Arial,sans-serif;color:#f4fff8">
    <div style="max-width:560px;margin:0 auto;padding:40px 20px">
      <div style="background:#10291d;border:1px solid #28583e;border-radius:18px;padding:32px;text-align:center">
        <h1 style="margin:0 0 12px;color:#55b77d">ElMourdy</h1>
        <p style="margin:0 0 24px;color:#c6d8cd">Hello <%= @user.name %>, use this code to verify your account:</p>
        <div style="font-size:34px;font-weight:700;letter-spacing:9px;background:#071b12;border-radius:12px;padding:18px"><%= @code %></div>
        <p style="margin:24px 0 0;color:#9db3a5;font-size:14px">This code expires in <%= @expires_in_minutes %> minutes. Do not share it with anyone.</p>
      </div>
    </div>
  </body>
</html>
